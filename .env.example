# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=claim-documents
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never expose to Client Components or NEXT_PUBLIC_*.
# Used for policy verification, claim writes, admin reads, and private storage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only OpenRouter key for AI claim analysis. Never use NEXT_PUBLIC_*.
OPENROUTER_API_KEY=your-openrouter-api-key
